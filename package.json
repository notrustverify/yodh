{
  "name": "yodh",
  "version": "2.0.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --webpack",
    "start": "next start",
    "export": "next build --webpack",
    "build": "next build --webpack",
    "devnet:build": "NEXT_PUBLIC_NETWORK=devnet next build --webpack",
    "testnet:build": "NEXT_PUBLIC_NETWORK=testnet next build --webpack",
    "mainnet:build": "NEXT_PUBLIC_NETWORK=mainnet next build --webpack",
    "compile": "cli compile",
    "deploy": "npm run devnet:deploy",
    "devnet:deploy": "cli deploy -n devnet",
    "testnet:deploy": "cli deploy -n testnet",
    "mainnet:deploy": "cli deploy -n mainnet",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest -i --config ./jest-config.json",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "pdf:verify": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"jsx\":\"react\"}' scripts/verify-gift-pdf.tsx"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "bracketSameLine": false,
    "trailingComma": "none"
  },
  "dependencies": {
    "@alephium/web3": "^3.0.5",
    "@alephium/web3-react": "^3.0.5",
    "@alephium/web3-wallet": "^3.0.5",
    "@alph-name-service/ans-sdk": "^0.1.0",
    "@react-pdf/renderer": "^3.4.4",
    "coingecko-api-v3": "^0.0.29",
    "detect-browser": "^5.3.0",
    "framer-motion": "^6.3.11",
    "js-sha256": "^0.11.0",
    "next": "^16.3.8",
    "next-qrcode": "^2.5.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.0.1",
    "react": "18.3.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "18.3.1",
    "react-icons": "^5.3.0",
    "react-modal": "^3.16.1",
    "react-select": "^5.8.0",
    "react-spinners": "^0.14.1",
    "react-tooltip": "^5.28.0",
    "react-transition-state": "^1.1.4",
    "react-use-measure": "^2.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "store2": "^2.14.3",
    "styled-components": "^5.3.5",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@alephium/cli": "^3.0.5",
    "@alephium/web3-test": "^3.0.5",
    "@iconify/react": "^5.0.2",
    "@types/jest": "^27.5.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/store": "^2.0.5",
    "@types/styled-components": "^5.1.25",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "encoding": "^0.1.13",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.4.2",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "eslint-config-next": "^16.3.8",
    "bip39": "^3.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
